order = 3
what = "Run independently configured agent harnesses concurrently inside their assigned territories"
why = "The game compares agents rather than one hard-coded client, and a stalled harness must not freeze the match"
how = "Reuse Replaybook's adapter contract where practical. Give each adapter an instruction, model, reasoning effort, deadline, credential proxy, and territory endpoint. Record normalized rounds, tool calls, usage, costs, stdout, stderr, and termination. Enforce per-agent inference resources separately from guest compute. Support cancellation when a territory is eliminated or the match ends. Never expose another agent's transcript, credential, or referee state."
backup = "Support Claux only behind the generic interface for the first match, then prove portability with a second adapter"
outcome = "success"

[context]
inputs = "Agent configurations, territory assignments, match deadline, controller-owned credential proxies"
outputs = "Concurrent agent sessions, normalized execution events, usage accounting, and terminal status"
dependencies = ["domain_and_manifests", "arena_runtime"]
tests = "Three fake adapters run concurrently; one timeout does not stop peers; cancellation kills process trees; credentials remain distinct; partial transcripts survive interruption; one real three-agent smoke match"
implementation = "crates/agent"
