order = 1
what = "Define strict build-race manifests, milestone dependency graphs, competitor states, evidence events, and scoring inputs"
why = "The runtime and referee need one validated vocabulary for construction progress before blank guests or paid agents start"
how = "Add an explicit arena mode and a build contract containing ordered milestone definitions. Validate stable IDs, non-empty controller verifier paths, positive points and timeouts, known dependencies, acyclic graphs, and a required completion milestone. Add build competitor states and immutable milestone evaluation, pass, failure, revocation, and durable-completion events. Extend replay state to retain evidence and dependency-valid score without removing the conquest prototype types during migration."
backup = "Represent the first arena as a fixed linear milestone list if a general DAG delays the first end-to-end build race"
outcome = "success"

[context]
inputs = "Build-race arena TOML, milestone verifier identifiers, agent and territory assignments"
outputs = "Validated BuildContract, milestone DAG, build event vocabulary, and replayable milestone ledger"
tests = "Valid DAG; missing build contract; unknown dependency; cycle; invalid completion milestone; evidence reduction; revocation subtracts score; existing conquest manifests remain valid"
implementation = "Added MatchMode, BuildContract, MilestoneConfig, CompetitorState, milestone lifecycle events, strict DAG validation, and replay views for evidence, points, failures, revocation, and durable completion. Updated SPEC.md and README.md to make build races primary while retaining the first-contact PvP prototype."
