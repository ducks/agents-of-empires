order = 7
what = "Provide a CLI and terminal interface for running, observing, inspecting, and replaying matches"
why = "The autonomous behavior needs to be legible and entertaining without making the visualization part of the referee's authority"
how = "Implement commands for validate, run, inspect, replay, and doctor. Render a network map, territory state, stack class, resources, match clock, standings, and chronological event feed. Show state without depending on color. Allow selecting a territory or event to inspect evidence and agent transcript. Drive live and replay modes through the same WorldState reducer. Keep JSON output available for future web viewers and automation."
backup = "Ship a line-oriented live event feed and final scoreboard before the interactive terminal map"

[context]
inputs = "CLI arguments, live event receiver, stored JSONL match logs, reduced world state"
outputs = "Exit status, terminal visualization, evidence views, and machine-readable summaries"
dependencies = ["agent_control", "referee_and_rules", "event_log_and_replay", "first_contact_arena"]
tests = "CLI parse and validation; non-TTY output; narrow terminal layout; no-color accessibility; live and replay screens reach identical final standings; SIGINT leaves an inspectable partial match"
