order = 2
what = "Provision and supervise disposable NixOS territories on a private arena network"
why = "Free-form agent competition is only acceptable when guests are reproducible, isolated, resource bounded, and disposable"
how = "Build each territory from a pinned NixOS configuration. Create a match-specific bridge with no public default route. Give the controller separate management access that guests cannot traverse. Enforce CPU, memory, disk, and network limits. Stage only territory-specific credentials and instructions. Expose start, stop, reboot, console, readiness, and teardown operations through a runtime trait. Always clean up after signals or controller failure."
backup = "Run one territory process at a time through Replaybook's existing host runtime while the multiplayer network supervisor is developed"

[context]
inputs = "Validated match plan and territory NixOS modules"
outputs = "Running isolated guests, management endpoints, arena network, and lifecycle events"
dependencies = ["domain_and_manifests"]
tests = "Three guests boot concurrently; guests reach intended peers; guests cannot reach public internet or controller services; unique credentials remain isolated; resource limits apply; teardown survives partial boot and SIGINT"
