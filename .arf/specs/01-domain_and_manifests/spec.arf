order = 1
what = "Define the typed domain model and strict manifests for arenas, territories, agents, rules, budgets, health checks, and events"
why = "Every runtime component needs one validated vocabulary; malformed arenas must fail before any VM or paid model starts"
how = "Create Rust types for ArenaManifest, TerritoryManifest, TerritoryClass, AgentConfig, Budget, HealthPolicy, MatchRules, TerritoryState, MatchState, and Event. Deserialize TOML with unknown-field rejection. Validate unique IDs and ports, class references, dependency reachability, budget bounds, health windows, and adapter configuration. Keep runtime state separate from declarative configuration."
backup = "Start with hard-coded three-territory types and serialize only the event model if the manifest surface delays the first match"

[context]
inputs = "Arena TOML, territory class TOML, agent adapter configurations"
outputs = "Validated immutable match plan and typed domain values"
tests = "Valid first-contact manifest; duplicate IDs; overlapping ports; missing classes; invalid health windows; zero or negative budgets; unknown fields; event serialization round trips"
