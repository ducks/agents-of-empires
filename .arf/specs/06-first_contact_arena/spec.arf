order = 6
what = "Build the first-contact arena with Gatekeeper, Archivist, and Courier territories"
why = "One intentionally small asymmetric arena is needed to prove that stack differences create meaningful strategies without relying on scripted attack buttons"
how = "Define three NixOS guests: an Nginx routing territory, a PostgreSQL durable-state territory, and a Redis worker territory. Give each one user-facing stateful behavior, scoped local credentials, observable dependencies, intended weaknesses, and a controller-only verifier. Ensure no territory has an automatic dominant path to every opponent. Seed limited topology clues while requiring network discovery. Add an oracle for each territory so referee correctness can be tested independently of agents."
backup = "Use two territories for lifecycle debugging, but do not call the game playable until all three asymmetric classes participate"

[context]
inputs = "Runtime interface, referee operations, first-contact arena manifest"
outputs = "Three reproducible territory images, health verifiers, oracles, and arena fixtures"
dependencies = ["arena_runtime", "referee_and_rules", "event_log_and_replay"]
tests = "All territories start healthy; each oracle survives durable verification; each intended weakness can degrade only arena targets; verifier and oracle never enter guests; repeated clean boots produce equivalent initial state"
