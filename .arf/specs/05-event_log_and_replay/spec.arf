order = 5
what = "Make an append-only event stream the source of truth for live state, post-match evidence, and deterministic replay"
why = "A battle is useful only if humans can understand what happened and reproduce every scoreboard decision"
how = "Assign controller-monotonic sequence numbers and timestamps to versioned JSONL events. Flush important lifecycle and outcome events durably. Implement a pure reducer from ordered events to WorldState. Add periodic snapshots as an optimization, never as authority. Validate ordering and schema versions while loading. Preserve uncertain attribution and unavailable outcomes without coercing them into wins or losses."
backup = "Store one JSONL file without snapshots; replay from sequence zero until match size proves snapshots necessary"

[context]
inputs = "Arena, agent, referee, resource, lifecycle, and infrastructure events"
outputs = "Durable JSONL log, reduced world state, optional snapshots, and replay API"
dependencies = ["domain_and_manifests", "referee_and_rules"]
tests = "Live and replayed final states match; truncated final line recovers; duplicate or missing sequence fails visibly; schema round trips; snapshots reproduce full reduction; partial match remains inspectable"
