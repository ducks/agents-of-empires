what = "Build the first playable Agents of Empires match: three asymmetric infrastructure agents competing concurrently in a sealed, externally verified arena"
why = "The core idea needs one reproducible match before adding more territory classes, balance systems, or a web presentation layer"

[[steps]]
order = 1
spec = "domain_and_manifests"
dir = "01-domain_and_manifests"
summary = "Typed arena manifests, territory classes, identifiers, state machines, events, and validation"

[[steps]]
order = 2
spec = "arena_runtime"
dir = "02-arena_runtime"
summary = "Build and supervise isolated NixOS territory VMs and their private network"
depends_on = ["domain_and_manifests"]

[[steps]]
order = 3
spec = "agent_control"
dir = "03-agent_control"
summary = "Dispatch harness-agnostic agents concurrently with isolated credentials, deadlines, and budgets"
depends_on = ["domain_and_manifests", "arena_runtime"]

[[steps]]
order = 4
spec = "referee_and_rules"
dir = "04-referee_and_rules"
summary = "Observe service health externally and resolve degradation, recovery, elimination, scoring, and infrastructure failures"
depends_on = ["domain_and_manifests", "arena_runtime", "agent_control"]

[[steps]]
order = 5
spec = "event_log_and_replay"
dir = "05-event_log_and_replay"
summary = "Persist immutable match events and reduce them into deterministic live and replayed world state"
depends_on = ["domain_and_manifests", "referee_and_rules"]

[[steps]]
order = 6
spec = "first_contact_arena"
dir = "06-first_contact_arena"
summary = "Implement and verify the Gatekeeper, Archivist, and Courier territories used by the first playable match"
depends_on = ["arena_runtime", "referee_and_rules", "event_log_and_replay"]

[[steps]]
order = 7
spec = "cli_and_tui"
dir = "07-cli_and_tui"
summary = "Run, inspect, and replay matches through a terminal network map, event feed, and evidence browser"
depends_on = ["agent_control", "referee_and_rules", "event_log_and_replay", "first_contact_arena"]
