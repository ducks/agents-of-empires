what = "Pivot Agents of Empires to a build-first arena where agents race from equivalent blank Linux hosts to externally verified durable services"
why = "Construction produces a clearer objective, more legible progress, and more useful infrastructure-agent evidence than beginning with unrestricted sabotage"

[[steps]]
order = 1
spec = "build_domain"
dir = "08-build_domain"
summary = "Build-race manifests, milestone DAGs, competitor states, events, scoring inputs, and strict validation"

[[steps]]
order = 2
spec = "blank_guest_runtime"
dir = "09-blank_guest_runtime"
summary = "Equivalent empty NixOS guests, sealed artifacts, adapter compatibility preflight, and SSH-only readiness"
depends_on = ["build_domain"]

[[steps]]
order = 3
spec = "milestone_referee"
dir = "10-milestone_referee"
summary = "Controller-owned milestone evaluation, opaque evidence, restart and reboot stages, revocation, and deterministic standings"
depends_on = ["build_domain", "blank_guest_runtime"]

[[steps]]
order = 4
spec = "first_build_arena"
dir = "11-first_build_arena"
summary = "A database-backed web-service contract raced concurrently on three equivalent blank hosts"
depends_on = ["blank_guest_runtime", "milestone_referee"]

[[steps]]
order = 5
spec = "build_race_controller"
dir = "12-build_race_controller"
summary = "Concurrent agents, bounded verifier scheduling, first-durable completion, deadline handling, and normalized failure sources"
depends_on = ["milestone_referee", "first_build_arena"]

[[steps]]
order = 6
spec = "build_race_tui"
dir = "13-build_race_tui"
summary = "Live and replayed milestone matrix, finish times, cost evidence, and concise verification event feed"
depends_on = ["build_race_controller"]

[[steps]]
order = 7
spec = "conquest_mode_design"
dir = "14-conquest_mode_design"
summary = "Future PvP rules in which verified constructed services unlock defensive and offensive capabilities"
depends_on = ["build_race_controller", "build_race_tui"]
