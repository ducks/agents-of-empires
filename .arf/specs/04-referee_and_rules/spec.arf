order = 4
what = "Implement an external referee that converts verified service observations into territory and match outcomes"
why = "Agents cannot be trusted to declare their own success, and competitive results need deterministic rules backed by evidence"
how = "Poll health and functional invariants from the controller. Apply rolling failure thresholds, degradation events, bounded recovery windows, final durable checks, and elimination. Separate player losses from arena, provider, and harness failures. Award uptime resources each tick, charge normalized inference resources, and resolve time-limit tie-breakers. Keep attack attribution optional and confidence labeled; last territory standing does not require attribution. Power off eliminated guests through the controller only."
backup = "Use fixed health intervals and last-territory-standing rules without attack attribution or resource generation for the first end-to-end match"

[context]
inputs = "Health observations, agent status, resource usage, match rules, infrastructure events"
outputs = "State transitions, budgets, standings, eliminations, final result, and supporting evidence"
dependencies = ["domain_and_manifests", "arena_runtime", "agent_control"]
tests = "Transient probe failure does not eliminate; persistent verified outage does; recovery within window restores health; restart-invalid repair fails; provider outage is unavailable rather than loss; deterministic timed tie-breakers"
